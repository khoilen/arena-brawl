{
  "name": "arena-brawl",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @arena-brawl/web dev",
    "build": "pnpm --filter @arena-brawl/web build",
    "typecheck": "pnpm --filter @arena-brawl/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arena-brawl/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.10.1"
  }
}
